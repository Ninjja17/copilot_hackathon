# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# OpenAI API Key (Optional: system provides high-fidelity local simulator fallback if omitted)
OPENAI_API_KEY=your_openai_api_key_here

# PagerDuty & Slack Incident Webhooks (Optional for production dispatch)
PAGERDUTY_INTEGRATION_KEY=your_pagerduty_routing_key_here
SLACK_INCIDENT_WEBHOOK_URL=your_slack_webhook_url_here
